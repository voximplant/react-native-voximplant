{
  "name": "react-native-voximplant",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.17.0",
  "scripts": {
    "clean": "yarn workspaces foreach -Ap --no-private run clean",
    "build": "yarn gen:spec && yarn workspaces foreach -Apt --no-private run build",
    "typecheck": "yarn workspaces foreach -Ap --no-private run typecheck",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "gen:spec": "node --experimental-transform-types scripts/generate-native-spec/index.mts",
    "gen:doc": "node doc/reactnative-v2.docs.mjs && node --experimental-transform-types doc/converter/converter.ts && ./doc/changelog-generator.py --input ./doc/CHANGELOG.md --fqdn references.reactnative-v2.changelog --title Changelog --output ./doc/reactnative-v2.ad.json",
    "release": "node --experimental-transform-types scripts/release.mts"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "cross-env": "^10.1.0",
    "del-cli": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^2.8.8",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-builder-bob": "0.40.18",
    "typedoc": "0.28.19",
    "typescript": "5.9.2"
  }
}
